	@Test
	void getApplicationHistory_success() {

		Long applicationId = 100L;
		String loginUserPersionType = "STAFF";

		List<ApplicationHistoryDTO> historyList = new ArrayList<>();

		ApplicationHistoryResp expectedResponse = new ApplicationHistoryResp(true, "", "04-Sep-2026", historyList);

		when(applicationListServiceImpl.getApplicationHistory(applicationId, loginUserPersionType))
				.thenReturn(expectedResponse);

		ResponseEntity<ApplicationHistoryResp> response = applicationController.getApplicationHistory(applicationId,
				loginUserPersionType);

		assertNotNull(response);
		assertEquals(HttpStatus.OK, response.getStatusCode());
		assertEquals(expectedResponse, response.getBody());

		verify(applicationListServiceImpl, times(1)).getApplicationHistory(applicationId, loginUserPersionType);
	}
}