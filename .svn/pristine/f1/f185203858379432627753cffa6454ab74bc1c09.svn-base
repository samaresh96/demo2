package com.jcboe.home.instruction.model.request;

public class ParentLogInReq {
	private String studentId;
	private String studentDob;
	private String configKeys;
	private String otpCode;
	private String studentPw;
	private String indicator;

	public ParentLogInReq() {
	}

	public ParentLogInReq(String studentId, String studentDob, String configKeys, String otpCode, String studentPw,
			String indicator) {
		this.studentId = studentId;
		this.studentDob = studentDob;
		this.configKeys = configKeys;
		this.otpCode = otpCode;
		this.studentPw = studentPw;
		this.indicator = indicator;
	}

	public String getStudentId() {
		return studentId;
	}

	public void setStudentId(String studentId) {
		this.studentId = studentId;
	}

	public String getStudentDob() {
		return studentDob;
	}

	public void setStudentDob(String studentDob) {
		this.studentDob = studentDob;
	}

	public String getConfigKeys() {
		return configKeys;
	}

	public void setConfigKeys(String configKeys) {
		this.configKeys = configKeys;
	}

	public String getOtpCode() {
		return otpCode;
	}

	public void setOtpCode(String otpCode) {
		this.otpCode = otpCode;
	}

	public String getStudentPw() {
		return studentPw;
	}

	public void setStudentPw(String studentPw) {
		this.studentPw = studentPw;
	}

	public String getIndicator() {
		return indicator;
	}

	public void setIndicator(String indicator) {
		this.indicator = indicator;
	}

	@Override
	public String toString() {
		return "ParentLogInReq [studentId=" + studentId + ", studentDob=" + studentDob + ", configKeys=" + configKeys
				+ ", otpCode=" + otpCode + ", studentPw=" + studentPw + ", indicator=" + indicator + "]";
	}
}
