package com.jcboe.home.instruction.response;

public class ApplicationList {
	private Long applicationId;
	private Long formTransactionId;
	private Long form1APHIRDataId;
	private Long studentId;
	private String studentName;
	private String schoolYear;
	private String applicationNo;
	private String applicationType;
	private String applicationTypeAbbr;
	private String studentSchool;
	private String studentGrade;
	private String applicationStatus;
	private String applicationStatusAbbr;
	private String applicationDate;
	private String classification;
	private String hiPeriod;
	private String updatedOn;
	private Boolean isActive;
	private String uploadedGeneratedTag;

	public ApplicationList() {
	}

	public ApplicationList(Long applicationId, Long formTransactionId, Long form1APHIRDataId, Long studentId,
			String studentName, String schoolYear, String applicationNo, String applicationType,
			String applicationTypeAbbr, String studentSchool, String studentGrade, String applicationStatus,
			String applicationStatusAbbr, String applicationDate, String classification, String hiPeriod,
			String updatedOn, Boolean isActive, String uploadedGeneratedTag) {
		this.applicationId = applicationId;
		this.formTransactionId = formTransactionId;
		this.form1APHIRDataId = form1APHIRDataId;
		this.studentId = studentId;
		this.studentName = studentName;
		this.schoolYear = schoolYear;
		this.applicationNo = applicationNo;
		this.applicationType = applicationType;
		this.applicationTypeAbbr = applicationTypeAbbr;
		this.studentSchool = studentSchool;
		this.studentGrade = studentGrade;
		this.applicationStatus = applicationStatus;
		this.applicationStatusAbbr = applicationStatusAbbr;
		this.applicationDate = applicationDate;
		this.classification = classification;
		this.hiPeriod = hiPeriod;
		this.updatedOn = updatedOn;
		this.isActive = isActive;
		this.uploadedGeneratedTag = uploadedGeneratedTag;
	}

	public Long getApplicationId() {
		return applicationId;
	}

	public void setApplicationId(Long applicationId) {
		this.applicationId = applicationId;
	}

	public Long getFormTransactionId() {
		return formTransactionId;
	}

	public void setFormTransactionId(Long formTransactionId) {
		this.formTransactionId = formTransactionId;
	}

	public Long getForm1APHIRDataId() {
		return form1APHIRDataId;
	}

	public void setForm1APHIRDataId(Long form1aphirDataId) {
		form1APHIRDataId = form1aphirDataId;
	}

	public Long getStudentId() {
		return studentId;
	}

	public void setStudentId(Long studentId) {
		this.studentId = studentId;
	}

	public String getStudentName() {
		return studentName;
	}

	public void setStudentName(String studentName) {
		this.studentName = studentName;
	}

	public String getSchoolYear() {
		return schoolYear;
	}

	public void setSchoolYear(String schoolYear) {
		this.schoolYear = schoolYear;
	}

	public String getApplicationNo() {
		return applicationNo;
	}

	public void setApplicationNo(String applicationNo) {
		this.applicationNo = applicationNo;
	}

	public String getApplicationType() {
		return applicationType;
	}

	public void setApplicationType(String applicationType) {
		this.applicationType = applicationType;
	}

	public String getApplicationTypeAbbr() {
		return applicationTypeAbbr;
	}

	public void setApplicationTypeAbbr(String applicationTypeAbbr) {
		this.applicationTypeAbbr = applicationTypeAbbr;
	}

	public String getStudentSchool() {
		return studentSchool;
	}

	public void setStudentSchool(String studentSchool) {
		this.studentSchool = studentSchool;
	}

	public String getStudentGrade() {
		return studentGrade;
	}

	public void setStudentGrade(String studentGrade) {
		this.studentGrade = studentGrade;
	}

	public String getApplicationStatus() {
		return applicationStatus;
	}

	public void setApplicationStatus(String applicationStatus) {
		this.applicationStatus = applicationStatus;
	}

	public String getApplicationStatusAbbr() {
		return applicationStatusAbbr;
	}

	public void setApplicationStatusAbbr(String applicationStatusAbbr) {
		this.applicationStatusAbbr = applicationStatusAbbr;
	}

	public String getApplicationDate() {
		return applicationDate;
	}

	public void setApplicationDate(String applicationDate) {
		this.applicationDate = applicationDate;
	}

	public String getClassification() {
		return classification;
	}

	public void setClassification(String classification) {
		this.classification = classification;
	}

	public String getHiPeriod() {
		return hiPeriod;
	}

	public void setHiPeriod(String hiPeriod) {
		this.hiPeriod = hiPeriod;
	}

	public String getUpdatedOn() {
		return updatedOn;
	}

	public void setUpdatedOn(String updatedOn) {
		this.updatedOn = updatedOn;
	}

	public Boolean getIsActive() {
		return isActive;
	}

	public void setIsActive(Boolean isActive) {
		this.isActive = isActive;
	}

	public String getUploadedGeneratedTag() {
		return uploadedGeneratedTag;
	}

	public void setUploadedGeneratedTag(String uploadedGeneratedTag) {
		this.uploadedGeneratedTag = uploadedGeneratedTag;
	}

	@Override
	public String toString() {
		return "ApplicationList [applicationId=" + applicationId + ", formTransactionId=" + formTransactionId
				+ ", form1APHIRDataId=" + form1APHIRDataId + ", studentId=" + studentId + ", studentName=" + studentName
				+ ", schoolYear=" + schoolYear + ", applicationNo=" + applicationNo + ", applicationType="
				+ applicationType + ", applicationTypeAbbr=" + applicationTypeAbbr + ", studentSchool=" + studentSchool
				+ ", studentGrade=" + studentGrade + ", applicationStatus=" + applicationStatus
				+ ", applicationStatusAbbr=" + applicationStatusAbbr + ", applicationDate=" + applicationDate
				+ ", classification=" + classification + ", hiPeriod=" + hiPeriod + ", updatedOn=" + updatedOn
				+ ", isActive=" + isActive + ", uploadedGeneratedTag=" + uploadedGeneratedTag + "]";
	}

}
