package com.jcboe.home.instruction.model.request;

public class GetAppListReq {

	private String configKeys;
	private String lookupType;
	private String schoolYear;
	private String status;
	private String student;
	private String schoolCode;
	private Integer gradeId;
	private String applicationNo;
	private String applicationDate;
	private Boolean allApplication;
	private int pagesize;
	private int pagenumber;
	private String loggedInUserId;
	private String loggedInUserPersonType;
	private Boolean isSummery;
	private Boolean isFilteredList;

	public GetAppListReq() {
	}

	public GetAppListReq(String configKeys, String lookupType, String schoolYear, String status, String student,
			String schoolCode, Integer gradeId, String applicationNo, String applicationDate, Boolean allApplication,
			int pagesize, int pagenumber, String loggedInUserId, String loggedInUserPersonType) {
		this.configKeys = configKeys;
		this.lookupType = lookupType;
		this.schoolYear = schoolYear;
		this.status = status;
		this.student = student;
		this.schoolCode = schoolCode;
		this.gradeId = gradeId;
		this.applicationNo = applicationNo;
		this.applicationDate = applicationDate;
		this.allApplication = allApplication;
		this.pagesize = pagesize;
		this.pagenumber = pagenumber;
		this.loggedInUserId = loggedInUserId;
		this.loggedInUserPersonType = loggedInUserPersonType;
	}

	public String getConfigKeys() {
		return configKeys;
	}

	public void setConfigKeys(String configKeys) {
		this.configKeys = configKeys;
	}

	public String getLookupType() {
		return lookupType;
	}

	public void setLookupType(String lookupType) {
		this.lookupType = lookupType;
	}

	public String getSchoolYear() {
		return schoolYear;
	}

	public void setSchoolYear(String schoolYear) {
		this.schoolYear = schoolYear;
	}

	public String getStatus() {
		return status;
	}

	public void setStatus(String status) {
		this.status = status;
	}

	public String getstudent() {
		return student;
	}

	public void setstudent(String student) {
		this.student = student;
	}

	public String getSchoolCode() {
		return schoolCode;
	}

	public void setSchoolCode(String schoolCode) {
		this.schoolCode = schoolCode;
	}

	public Integer getGradeId() {
		return gradeId;
	}

	public void setGradeId(Integer gradeId) {
		this.gradeId = gradeId;
	}

	public String getApplicationNo() {
		return applicationNo;
	}

	public void setApplicationNo(String applicationNo) {
		this.applicationNo = applicationNo;
	}

	public String getApplicationDate() {
		return applicationDate;
	}

	public void setApplicationDate(String applicationDate) {
		this.applicationDate = applicationDate;
	}

	public Boolean getAllApplication() {
		return allApplication;
	}

	public void setAllApplication(Boolean allApplication) {
		this.allApplication = allApplication;
	}

	public int getPagesize() {
		return pagesize;
	}

	public void setPagesize(int pagesize) {
		this.pagesize = pagesize;
	}

	public int getPagenumber() {
		return pagenumber;
	}

	public void setPagenumber(int pagenumber) {
		this.pagenumber = pagenumber;
	}

	public String getLoggedInUserId() {
		return loggedInUserId;
	}

	public void setLoggedInUserId(String loggedInUserId) {
		this.loggedInUserId = loggedInUserId;
	}

	public String getLoggedInUserPersonType() {
		return loggedInUserPersonType;
	}

	public void setLoggedInUserPersonType(String loggedInUserPersonType) {
		this.loggedInUserPersonType = loggedInUserPersonType;
	}

	public Boolean getIsSummery() {
		return isSummery;
	}

	public void setIsSummery(Boolean isSummery) {
		this.isSummery = isSummery;
	}

	public Boolean getIsFilteredList() {
		return isFilteredList;
	}

	public void setIsFilteredList(Boolean isFilteredList) {
		this.isFilteredList = isFilteredList;
	}

	@Override
	public String toString() {
		return "GetAppListReq [configKeys=" + configKeys + ", lookupType=" + lookupType + ", schoolYear=" + schoolYear
				+ ", status=" + status + ", student=" + student + ", schoolCode=" + schoolCode + ", gradeId=" + gradeId
				+ ", applicationNo=" + applicationNo + ", applicationDate=" + applicationDate + ", allApplication="
				+ allApplication + ", pagesize=" + pagesize + ", pagenumber=" + pagenumber + ", loggedInUserId="
				+ loggedInUserId + ", loggedInUserPersonType=" + loggedInUserPersonType + ", isSummery=" + isSummery
				+ ", isFilteredList=" + isFilteredList + "]";
	}

	
	

}
