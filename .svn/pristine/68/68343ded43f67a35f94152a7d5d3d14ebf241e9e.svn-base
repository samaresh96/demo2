package com.jcboe.home.instruction.model.request;

public class GetStudentInfoReqById {
	private String studentId;
	private String calledFrom;
	private String configKeys;

	public GetStudentInfoReqById() {
	}

	public GetStudentInfoReqById(String studentId, String calledFrom) {
		this.studentId = studentId;
		this.calledFrom = calledFrom;
	}

	public String getStudentId() {
		return studentId;
	}

	public void setStudentId(String studentId) {
		this.studentId = studentId;
	}

	public String getCalledFrom() {
		return calledFrom;
	}

	public void setCalledFrom(String calledFrom) {
		this.calledFrom = calledFrom;
	}

	public String getConfigKeys() {
		return configKeys;
	}

	public void setConfigKeys(String configKeys) {
		this.configKeys = configKeys;
	}

	@Override
	public String toString() {
		return "GetStudentInfoReqById [studentId=" + studentId + ", calledFrom=" + calledFrom + ", configKeys="
				+ configKeys + "]";
	}

}
