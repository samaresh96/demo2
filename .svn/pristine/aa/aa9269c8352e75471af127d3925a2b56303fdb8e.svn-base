package com.jcboe.home.instruction.response;

public class IdsKeyValue {
	private static final long serialVersionUID = 7195734931586784896L;

	private String key;
	private String value;

	public IdsKeyValue() {
	}

	public IdsKeyValue(String key, String value) {
		this.key = key;
		this.value = value;
	}

	public String getKey() {
		return key;
	}

	public void setKey(String key) {
		this.key = key;
	}

	public String getValue() {
		return value;
	}

	public void setValue(String value) {
		this.value = value;
	}

	public static long getSerialversionuid() {
		return serialVersionUID;
	}

	@Override
	public String toString() {
		return "IdsKeyValue [key=" + key + ", value=" + value + "]";
	}

}
