	}

	public List<ApplicationHistoryDTO> getApplicationHistory(Long applicationId, String loggedInUserPersonType)
			throws Exception {

		logger.info("Calling db function fn_get_application_history with application id: {},loggedInUserPersonType:{}",
				applicationId, loggedInUserPersonType);

		final String query = "SELECT * FROM fn_get_application_history(:p_application_id,:p_logged_in_user_person_type)";

		Map<String, Object> params = new HashMap<>();

		params.put("p_application_id", applicationId);
		params.put("p_logged_in_user_person_type", loggedInUserPersonType);

		try {

			List<ApplicationHistoryDTO> result = jdbcTemplate.query(query, params,
					(rs, rowNum) -> new ApplicationHistoryDTO(rs.getLong("id"), rs.getString("action"),
							rs.getString("action_abbreviation"), rs.getString("status"),
							rs.getString("status_abbreviation"), rs.getString("comment"),
							rs.getString("action_taken_by"), rs.getString("action_taken_on"),
							rs.getString("action_taken_by_person_type")));

			logger.debug("Response received from the database: {}", result);

			return result;

		} catch (Exception e) {

			logger.error("Exception occurred while interacting with database: {}", e.getMessage(), e);

			throw new Exception(e);
		}
	}

