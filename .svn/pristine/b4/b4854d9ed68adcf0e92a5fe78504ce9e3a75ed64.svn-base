package com.jcboe.home.instruction.model.request;

public class AdminLogInReq {
	private String userId;
	private String password;
	private String configKeys;
	private String userType;

	public AdminLogInReq() {
	}

	public AdminLogInReq(String userId, String password, String configKeys, String userType) {

		this.userId = userId;
		this.password = password;
		this.configKeys = configKeys;
		this.userType = userType;
	}

	public String getUserId() {
		return userId;
	}

	public void setUserId(String userId) {
		this.userId = userId;
	}

	public String getPassword() {
		return password;
	}

	public void setPassword(String password) {
		this.password = password;
	}

	public String getConfigKeys() {
		return configKeys;
	}

	public void setConfigKeys(String configKeys) {
		this.configKeys = configKeys;
	}

	public String getUserType() {
		return userType;
	}

	public void setUserType(String userType) {
		this.userType = userType;
	}

	@Override
	public String toString() {
		return "AdminLogInReq [userId=" + userId + ", password=" + password + ", configKeys=" + configKeys
				+ ", userType=" + userType + "]";
	}

}
