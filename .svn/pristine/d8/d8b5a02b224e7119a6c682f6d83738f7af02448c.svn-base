		this.erPrimaryPh = erPrimaryPh;
		this.erPrimaryRelation = erPrimaryRelation;
		this.erSecondPh = erSecondPh;
		this.erSecondRelation = erSecondRelation;
		this.physicianPh = physicianPh;
		this.physicianName = physicianName;
		this.physicianAddr = physicianAddr;
		this.physicianExist = physicianExist;
		this.submittedOn = submittedOn;
		this.note = note;
		this.active = active;
		this.atheleticFormId = atheleticFormId;
		this.formShortName = formShortName;
		this.address = address;
		this.stuedentInfoId = stuedentInfoId;

		this.submissionDetailId = submissionDetailId;
		this.formName = formName;
		this.formType = formType;
		this.pdfName = pdfName;
		this.specialType = specialType;
		this.formTypeName = formTypeName;
		this.formStatus = formStatus;
		this.createdOn = createdOn;
		this.schoolYear = schoolYear;
