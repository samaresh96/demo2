package com.jcboe.home.instruction.response;

public class EmailResponse {
	private String studentEmailId;
	private String studentDob;
	private String otpSendOn;

	public EmailResponse() {
	}

	public EmailResponse(String studentEmailId, String studentDob, String otpSendOn) {
		this.studentEmailId = studentEmailId;
		this.studentDob = studentDob;
		this.otpSendOn = otpSendOn;
	}

	public String getStudentEmailId() {
		return studentEmailId;
	}

	public void setStudentEmailId(String studentEmailId) {
		this.studentEmailId = studentEmailId;
	}

	public String getStudentDob() {
		return studentDob;
	}

	public void setStudentDob(String studentDob) {
		this.studentDob = studentDob;
	}

	public String getOtpSendOn() {
		return otpSendOn;
	}

	public void setOtpSendOn(String otpSendOn) {
		this.otpSendOn = otpSendOn;
	}

	@Override
	public String toString() {
		return "EmailResponse [studentEmailId=" + studentEmailId + ", studentDob=" + studentDob + ", otpSendOn="
				+ otpSendOn + "]";
	}

}
