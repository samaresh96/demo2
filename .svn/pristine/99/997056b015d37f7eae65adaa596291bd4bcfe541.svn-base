package com.jcboe.home.instruction.model.request;

public class UserInfoReq {
	private String indicator;
	private String employeeId;
	private String userType;
	private String phoneNumber1;
	private String phoneNumber2;

	public UserInfoReq() {

	}

	public UserInfoReq(String indicator, String employeeId, String userType, String phoneNumber1, String phoneNumber2) {
		this.indicator = indicator;
		this.employeeId = employeeId;
		this.userType = userType;
		this.phoneNumber1 = phoneNumber1;
		this.phoneNumber2 = phoneNumber2;
	}

	public String getIndicator() {
		return indicator;
	}

	public void setIndicator(String indicator) {
		this.indicator = indicator;
	}

	public String getEmployeeId() {
		return employeeId;
	}

	public void setEmployeeId(String employeeId) {
		this.employeeId = employeeId;
	}

	public String getUserType() {
		return userType;
	}

	public void setUserType(String userType) {
		this.userType = userType;
	}

	public String getPhoneNumber1() {
		return phoneNumber1;
	}

	public void setPhoneNumber1(String phoneNumber1) {
		this.phoneNumber1 = phoneNumber1;
	}

	public String getPhoneNumber2() {
		return phoneNumber2;
	}

	public void setPhoneNumber2(String phoneNumber2) {
		this.phoneNumber2 = phoneNumber2;
	}

	@Override
	public String toString() {
		return "UserInfoReq [indicator=" + indicator + ", employeeId=" + employeeId + ", userType=" + userType
				+ ", phoneNumber1=" + phoneNumber1 + ", phoneNumber2=" + phoneNumber2 + "]";
	}

}
