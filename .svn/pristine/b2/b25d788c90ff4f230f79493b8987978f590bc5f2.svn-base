<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RegisterUserEmailTemplate</title>
</head>

<body>
    <p>
        Student ID : {STUDENT_ID} <br />
        Student DOB : {STUDENT_DOB} <br />
    </p>
	
	<p> 
		Your One Time Code for Parent Registration is <span
            style="font-size: 16px;font-weight: bold;">{ONE_TIME_CODE}</span>.
	</p>

    <p>
        Register your email in JCBOE Application {APPLICATION_NAME} using the Link <a
            href="{APPLICATION_HYPER_LINK}">Email Verification</a>
    </p>
</body>

</html>