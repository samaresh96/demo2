package com.jcboe.home.instruction.response;

public class LookupDetails {
	private String lookuptype;

	private int lookupvalueid;

	private String lookupvalue;

	private String lookupabbreviation;
	private boolean active;
	
	public LookupDetails() {
	
	}

	public LookupDetails(String lookuptype, int lookupvalueid, String lookupvalue, String lookupabbreviation,
			boolean active) {
		this.lookuptype = lookuptype;
		this.lookupvalueid = lookupvalueid;
		this.lookupvalue = lookupvalue;
		this.lookupabbreviation = lookupabbreviation;
		this.active = active;
	}

	public String getLookuptype() {
		return lookuptype;
	}

	public void setLookuptype(String lookuptype) {
		this.lookuptype = lookuptype;
	}

	public int getLookupvalueid() {
		return lookupvalueid;
	}

	public void setLookupvalueid(int lookupvalueid) {
		this.lookupvalueid = lookupvalueid;
	}

	public String getLookupvalue() {
		return lookupvalue;
	}

	public void setLookupvalue(String lookupvalue) {
		this.lookupvalue = lookupvalue;
	}

	public String getLookupabbreviation() {
		return lookupabbreviation;
	}

	public void setLookupabbreviation(String lookupabbreviation) {
		this.lookupabbreviation = lookupabbreviation;
	}

	public boolean isActive() {
		return active;
	}

	public void setActive(boolean active) {
		this.active = active;
	}

	@Override
	public String toString() {
		return "LookupDetails [lookuptype=" + lookuptype + ", lookupvalueid=" + lookupvalueid + ", lookupvalue="
				+ lookupvalue + ", lookupabbreviation=" + lookupabbreviation + ", active=" + active + "]";
	}
	
	
}
