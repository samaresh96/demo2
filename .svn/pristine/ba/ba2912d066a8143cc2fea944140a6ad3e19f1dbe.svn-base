	@Test
	void getApplicationHistory_exception() throws Exception {

		Long applicationId = 100L;
		String loginUserPersionType = "STAFF";

		when(formRepo.getApplicationHistory(applicationId, loginUserPersionType))
				.thenThrow(new Exception("Database error"));

		HomeInstructionException exception = assertThrows(HomeInstructionException.class,
				() -> formRepo.getApplicationHistory(applicationId, loginUserPersionType));

		assertEquals(Constant.INTERNAL_SERVER_ERROR, exception.getErrorCode());

		verify(formRepo, times(1)).getApplicationHistory(applicationId, loginUserPersionType);
	}

	@Test
	@SuppressWarnings("unchecked")
	void testGetApplicationHistory() throws Exception {

		Long applicationId = 100L;
		String loginUserPersionType = "STAFF";

		Mockito.when(jdbcTemplate.query(Mockito.anyString(), Mockito.anyMap(),
				ArgumentMatchers.<RowMapper<ApplicationHistoryDTO>>any())).thenAnswer(invocation -> {

					RowMapper<ApplicationHistoryDTO> mapper = (RowMapper<ApplicationHistoryDTO>) invocation
							.getArgument(2);

					ResultSet rs = Mockito.mock(ResultSet.class);

					Mockito.when(rs.getLong("id")).thenReturn(1L);
					Mockito.when(rs.getString("action")).thenReturn("Submitted");
					Mockito.when(rs.getString("action_abbreviation")).thenReturn("SUB");
					Mockito.when(rs.getString("status")).thenReturn("Completed");
					Mockito.when(rs.getString("status_abbreviation")).thenReturn("CMP");
					Mockito.when(rs.getString("comment")).thenReturn("Test comment");
					Mockito.when(rs.getString("action_taken_by")).thenReturn("John Doe");
					Mockito.when(rs.getString("action_taken_on")).thenReturn("04-Sep-2026");
					Mockito.when(rs.getString("action_taken_by_person_type")).thenReturn("STAFF");

					return Arrays.asList(mapper.mapRow(rs, 0));
				});

		List<ApplicationHistoryDTO> result = formRepo.getApplicationHistory(applicationId, loginUserPersionType);

		assertNotNull(result);
		assertEquals(1, result.size());

	}

	@Test
	void getApplicationHistory_emptyResult() throws Exception {

		Long applicationId = 100L;
		String loginUserPersionType = "STAFF";

		when(jdbcTemplate.query(anyString(), anyMap(), ArgumentMatchers.<RowMapper<ApplicationHistoryDTO>>any()))
				.thenReturn(Collections.emptyList());

		List<ApplicationHistoryDTO> result = formRepo.getApplicationHistory(applicationId, loginUserPersionType);

		assertNotNull(result);
