				ArgumentMatchers.<RowMapper<ApplicationHistoryDTO>>any());
	}

	@Test
	void getApplicationHistory_databaseException() {

		Long applicationId = 100L;
		String loginUserPersionType = "STAFF";

		when(jdbcTemplate.query(anyString(), anyMap(), ArgumentMatchers.<RowMapper<ApplicationHistoryDTO>>any()))
				.thenThrow(new RuntimeException("Database error"));

		Exception exception = assertThrows(Exception.class,
				() -> formRepo.getApplicationHistory(applicationId, loginUserPersionType));

		assertNotNull(exception);
		assertEquals("Database error", exception.getCause().getMessage());

		verify(jdbcTemplate, times(1)).query(anyString(), anyMap(),
				ArgumentMatchers.<RowMapper<ApplicationHistoryDTO>>any());

	}
