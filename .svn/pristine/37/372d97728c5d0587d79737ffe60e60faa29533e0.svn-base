package com.jcboe.home.instruction.response;

public class Form9EAPPPlanDataResp {
	private Long id;
	private Long form9EappDataId;
	private String planType;
	private String plan1;
	private String plan2;

	public Form9EAPPPlanDataResp() {
		super();
	}

	public Form9EAPPPlanDataResp(Long id, Long form9EappDataId, String planType, String plan1, String plan2) {
		super();
		this.id = id;
		this.form9EappDataId = form9EappDataId;
		this.planType = planType;
		this.plan1 = plan1;
		this.plan2 = plan2;
	}

	public Long getId() {
		return id;
	}

	public void setId(Long id) {
		this.id = id;
	}

	public Long getForm9EappDataId() {
		return form9EappDataId;
	}

	public void setForm9EappDataId(Long form9EappDataId) {
		this.form9EappDataId = form9EappDataId;
	}

	public String getPlanType() {
		return planType;
	}

	public void setPlanType(String planType) {
		this.planType = planType;
	}

	public String getPlan1() {
		return plan1;
	}

	public void setPlan1(String plan1) {
		this.plan1 = plan1;
	}

	public String getPlan2() {
		return plan2;
	}

	public void setPlan2(String plan2) {
		this.plan2 = plan2;
	}

	@Override
	public String toString() {
		return "Form9EAPPPlanDataResp [id=" + id + ", form9EappDataId=" + form9EappDataId + ", planType=" + planType
				+ ", plan1=" + plan1 + ", plan2=" + plan2 + "]";
	}

}
