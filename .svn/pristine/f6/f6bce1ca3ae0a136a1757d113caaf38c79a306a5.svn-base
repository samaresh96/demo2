package com.jcboe.home.instruction.response;

public class Message {

	private int messageId;
	private String apiRef;
	private String messageRef;
	private String messageText;
	private String messageType;

	public Message() {
	}

	public Message(int messageId, String apiRef, String messageRef, String messageText, String messageType) {
		this.messageId = messageId;
		this.apiRef = apiRef;
		this.messageRef = messageRef;
		this.messageText = messageText;
		this.messageType = messageType;
	}

	public int getMessageId() {
		return messageId;
	}

	public void setMessageId(int messageId) {
		this.messageId = messageId;
	}

	public String getApiRef() {
		return apiRef;
	}

	public void setApiRef(String apiRef) {
		this.apiRef = apiRef;
	}

	public String getMessageRef() {
		return messageRef;
	}

	public void setMessageRef(String messageRef) {
		this.messageRef = messageRef;
	}

	public String getMessageText() {
		return messageText;
	}

	public void setMessageText(String messageText) {
		this.messageText = messageText;
	}

	public String getMessageType() {
		return messageType;
	}

	public void setMessageType(String messageType) {
		this.messageType = messageType;
	}

	@Override
	public String toString() {
		return "Message [messageId=" + messageId + ", apiRef=" + apiRef + ", messageRef=" + messageRef
				+ ", messageText=" + messageText + ", messageType=" + messageType + "]";
	}

}
