		map.put("AASCS", "Nurse Sends Expulsion/Administrative Applicationto School Counsellor");
		map.put("THISBM", "Nurse Submits Request for Temporary Home Instruction");
		map.put("DCAP", "Physician Approves");
		map.put("THDSBM", "Doctor Submits Request for Temporary Home Instruction");
		map.put("DCDN", "Physician Denies");
		map.put("DCRQ", "Physician Raises Query");
		map.put("CLBNP", "Nurse submits Clarification to Physician");
		map.put("NRSRQ", "Nurse Raises Query to Student");
		map.put("CLBS", "Student submits Clarification");
		map.put("SDSCP", "Save As Draft After Filling Home Instruction Student Profile");
		map.put("STCN", "Send to Counsellor After Filling Home Instruction Student Profile");
		map.put("FILBCN", "Fill up of Section B of 'Home Instruction Student Profile' by Counsellor");
		map.put("APC", "Completion of Academic Progress Plan");
		map.put("STHI", "Send to HI Department");
		map.put("RQBHI", "HI Department Raises Query");
		map.put("CLBNHI", "Nurse submits Clarification to HI Department");
		map.put("HIAPRV", "HI Department Approves");
		map.put("FAPRV", "Final Approval by HI Approver");
		map.put("HIDN", "HI Approver Denies");
		map.put("TCAS", "Principal Assigns Teacher");
		map.put("TDNTC", "Generate 30 Day Notice");
		map.put("SDNTC", "Generate 60 Day Notice");
		map.put("NTCST", "Nurse Generates Notice to CST");

