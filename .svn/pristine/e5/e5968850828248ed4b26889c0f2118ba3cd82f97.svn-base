package com.jcboe.home.instruction.response;

import com.fasterxml.jackson.annotation.JsonProperty;

/**
 * 
 * 
 * Date: 09-Dec-2022 Class: UserDetail.java Purpose: model class use for various
 * purpose
 *
 */
public class UserDetail {

	private long id;
	@JsonProperty("userActivityID")
	private long userActivityId;
	@JsonProperty("employeeID")
	private long employeeId;
	private String employeeFirstName;
	private String employeeMiddleName;
	private String employeeLastName;
	private String employeeName;
	@JsonProperty("activityID")
	private long activityId;
	private long createdBy;
	private long madeInactiveBy;
	@JsonProperty("isActive")
	private boolean active;
	@JsonProperty("locationID")
	private String locationId;
	private String location;
	private String effectiveDate;
	private String endDate;
	private String indicator;

	@JsonProperty("isUserAssignable")
	private boolean userAssignable;

	private String userActLocIds;
	private String userActLocations;
	private String thresholdAmount;
	private String thresholdHour;

	public UserDetail() {
	}

	public UserDetail(long id, long userActivityId, long employeeId, String employeeFirstName,
			String employeeMiddleName, String employeeLastName, String employeeName, long activityId, long createdBy,
			long madeInactiveBy, boolean active, String locationId, String location) {
		this.id = id;
		this.userActivityId = userActivityId;
		this.employeeId = employeeId;
		this.employeeFirstName = employeeFirstName;
		this.employeeMiddleName = employeeMiddleName;
		this.employeeLastName = employeeLastName;
		this.employeeName = employeeName;
		this.activityId = activityId;
		this.createdBy = createdBy;
		this.madeInactiveBy = madeInactiveBy;
		this.active = active;
		this.locationId = locationId;
		this.location = location;
	}

	public UserDetail(long id, long userActivityId, long employeeId, String employeeName, long activityId,
			boolean active, String locationId, String location, String effectiveDate, String endDate,
			boolean userAssignable, String userActLocIds, String userActLocations, String thresholdAmount,
			String thresholdHour) {
		this.id = id;
		this.userActivityId = userActivityId;
		this.employeeId = employeeId;
		this.employeeName = employeeName;
		this.activityId = activityId;
		this.active = active;
		this.locationId = locationId;
		this.location = location;
		this.effectiveDate = effectiveDate;
		this.endDate = endDate;
		this.userAssignable = userAssignable;
		this.userActLocIds = userActLocIds;
		this.userActLocations = userActLocations;
		this.thresholdAmount = thresholdAmount;
		this.thresholdHour = thresholdHour;
	}

	public long getId() {
		return id;
	}

	public void setId(long id) {
		this.id = id;
	}

	public long getUserActivityId() {
		return userActivityId;
	}

	public void setUserActivityId(long userActivityId) {
		this.userActivityId = userActivityId;
	}

	public long getEmployeeId() {
		return employeeId;
	}

	public void setEmployeeId(long employeeId) {
		this.employeeId = employeeId;
	}

	public String getEmployeeFirstName() {
		return employeeFirstName;
	}

	public void setEmployeeFirstName(String employeeFirstName) {
		this.employeeFirstName = employeeFirstName;
	}

	public String getEmployeeMiddleName() {
		return employeeMiddleName;
	}

	public void setEmployeeMiddleName(String employeeMiddleName) {
		this.employeeMiddleName = employeeMiddleName;
	}

	public String getEmployeeLastName() {
		return employeeLastName;
	}

	public void setEmployeeLastName(String employeeLastName) {
		this.employeeLastName = employeeLastName;
	}

	public String getEmployeeName() {
		return employeeName;
	}

	public void setEmployeeName(String employeeName) {
		this.employeeName = employeeName;
	}

	public long getActivityId() {
		return activityId;
	}

	public void setActivityId(long activityId) {
		this.activityId = activityId;
	}

	public long getCreatedBy() {
		return createdBy;
	}

	public void setCreatedBy(long createdBy) {
		this.createdBy = createdBy;
	}

	public long getMadeInactiveBy() {
		return madeInactiveBy;
	}

	public void setMadeInactiveBy(long madeInactiveBy) {
		this.madeInactiveBy = madeInactiveBy;
	}

	public boolean isActive() {
		return active;
	}

	public void setActive(boolean active) {
		this.active = active;
	}

	public String getLocation() {
		return location;
	}

	public void setLocation(String location) {
		this.location = location;
	}

	public String getLocationId() {
		return locationId;
	}

	public void setLocationId(String locationId) {
		this.locationId = locationId;
	}

	public String getEffectiveDate() {
		return effectiveDate;
	}

	public void setEffectiveDate(String effectiveDate) {
		this.effectiveDate = effectiveDate;
	}

	public String getEndDate() {
		return endDate;
	}

	public void setEndDate(String endDate) {
		this.endDate = endDate;
	}

	public String getIndicator() {
		return indicator;
	}

	public void setIndicator(String indicator) {
		this.indicator = indicator;
	}

	public boolean isUserAssignable() {
		return userAssignable;
	}

	public void setUserAssignable(boolean userAssignable) {
		this.userAssignable = userAssignable;
	}

	public String getUserActLocIds() {
		return userActLocIds;
	}

	public void setUserActLocIds(String userActLocIds) {
		this.userActLocIds = userActLocIds;
	}

	public String getUserActLocations() {
		return userActLocations;
	}

	public void setUserActLocations(String userActLocations) {
		this.userActLocations = userActLocations;
	}

	public String getThresholdAmount() {
		return thresholdAmount;
	}

	public void setThresholdAmount(String thresholdAmount) {
		this.thresholdAmount = thresholdAmount;
	}

	public String getThresholdHour() {
		return thresholdHour;
	}

	public void setThresholdHour(String thresholdHour) {
		this.thresholdHour = thresholdHour;
	}

	@Override
	public String toString() {
		return "UserDetail [id=" + id + ", userActivityId=" + userActivityId + ", employeeId=" + employeeId
				+ ", employeeFirstName=" + employeeFirstName + ", employeeMiddleName=" + employeeMiddleName
				+ ", employeeLastName=" + employeeLastName + ", employeeName=" + employeeName + ", activityId="
				+ activityId + ", createdBy=" + createdBy + ", madeInactiveBy=" + madeInactiveBy + ", active=" + active
				+ ", locationId=" + locationId + ", location=" + location + ", effectiveDate=" + effectiveDate
				+ ", endDate=" + endDate + ", indicator=" + indicator + ", userAssignable=" + userAssignable
				+ ", userActLocIds=" + userActLocIds + ", userActLocations=" + userActLocations + ", thresholdAmount="
				+ thresholdAmount + ", thresholdHour=" + thresholdHour + "]";
	}

}
