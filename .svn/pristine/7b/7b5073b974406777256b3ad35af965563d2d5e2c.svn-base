package com.jcboe.home.instruction.response;

public class JCBOEApplicationDTO {

	private int applicationId;
	private String applicationName;
	private String applicationUrl;
	private String applicationAbbvr;
	private String applicationLocalUrl;

	public JCBOEApplicationDTO() {
	}

	public JCBOEApplicationDTO(int applicationId, String applicationName, String applicationUrl,
			String applicationAbbvr, String applicationLocalUrl) {
		this.applicationId = applicationId;
		this.applicationName = applicationName;
		this.applicationUrl = applicationUrl;
		this.applicationAbbvr = applicationAbbvr;
		this.applicationLocalUrl = applicationLocalUrl;
	}

	public int getApplicationId() {
		return applicationId;
	}

	public void setApplicationId(int applicationId) {
		this.applicationId = applicationId;
	}

	public String getApplicationName() {
		return applicationName;
	}

	public void setApplicationName(String applicationName) {
		this.applicationName = applicationName;
	}

	public String getApplicationUrl() {
		return applicationUrl;
	}

	public void setApplicationUrl(String applicationUrl) {
		this.applicationUrl = applicationUrl;
	}

	public String getApplicationAbbvr() {
		return applicationAbbvr;
	}

	public void setApplicationAbbvr(String applicationAbbvr) {
		this.applicationAbbvr = applicationAbbvr;
	}

	public String getApplicationLocalUrl() {
		return applicationLocalUrl;
	}

	public void setApplicationLocalUrl(String applicationLocalUrl) {
		this.applicationLocalUrl = applicationLocalUrl;
	}

	@Override
	public String toString() {
		return "JCBOEApplicationDTO [applicationId=" + applicationId + ", applicationName=" + applicationName
				+ ", applicationUrl=" + applicationUrl + ", applicationAbbvr=" + applicationAbbvr
				+ ", applicationLocalUrl=" + applicationLocalUrl + "]";
	}
}
