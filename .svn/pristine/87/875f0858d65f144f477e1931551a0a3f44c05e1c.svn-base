package com.jcboe.home.instruction.response;

public class AppStatusListResp {
	private String applnstsAbbvrs;
	private String statusText;

	public AppStatusListResp() {
	}

	public AppStatusListResp(String applnstsAbbvrs, String statusText) {
		this.applnstsAbbvrs = applnstsAbbvrs;
		this.statusText = statusText;
	}

	public String getApplnstsAbbvrs() {
		return applnstsAbbvrs;
	}

	public void setApplnstsAbbvrs(String applnstsAbbvrs) {
		this.applnstsAbbvrs = applnstsAbbvrs;
	}

	public String getStatusText() {
		return statusText;
	}

	public void setStatusText(String statusText) {
		this.statusText = statusText;
	}

	@Override
	public String toString() {
		return "AppStatusListResp [applnstsAbbvrs=" + applnstsAbbvrs + ", statusText=" + statusText + "]";
	}

}
