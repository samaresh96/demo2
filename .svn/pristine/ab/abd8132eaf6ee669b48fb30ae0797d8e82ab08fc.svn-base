package com.jcboe.home.instruction.model.request;

public class Form4Request {
	private String indicator;
	private String schoolYear;
	private Long id;
	private String studentId;
	private String activity;
	private String status;
	private String comment;
	private Long applicationId;
	private Long formMasterId;
	private String formAbbreviation;
	private Boolean isTeacherAccept;
	private Boolean isTeacherRecommend;
	private Boolean isTeacherCertified;
	private String teacherArea1;
	private String teacherArea2;
	private String teacherArea3;
	private String teacherArea4;
	private String teacherName;
	private String teacherSchool;
	private String teacherHomePhone;
	private String teacherWorkPhone;
	private String teacherSignature;
	private String teacherSignDate;
	private String principalSignature;
	private String principalSignDate;
	private String loggedInUserId;
	private String loggedInUserPersonType;

	public Form4Request() {

	}

