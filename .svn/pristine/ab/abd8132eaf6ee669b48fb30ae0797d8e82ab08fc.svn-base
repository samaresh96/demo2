				+ ", teacherName=" + teacherName + ", teacherSchool=" + teacherSchool + ", teacherHomePhone="
				+ teacherHomePhone + ", teacherWorkPhone=" + teacherWorkPhone + ", teacherSignature=" + teacherSignature
