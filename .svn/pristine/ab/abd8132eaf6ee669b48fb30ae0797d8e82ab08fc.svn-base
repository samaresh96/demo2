		this.indicator = indicator;
		this.schoolYear = schoolYear;
		this.id = id;
		this.studentId = studentId;
		this.activity = activity;
		this.status = status;
		this.comment = comment;
		this.applicationId = applicationId;
		this.formMasterId = formMasterId;
		this.formAbbreviation = formAbbreviation;
		this.isTeacherAccept = isTeacherAccept;
		this.isTeacherRecommend = isTeacherRecommend;
		this.isTeacherCertified = isTeacherCertified;
		this.teacherArea1 = teacherArea1;
		this.teacherArea2 = teacherArea2;
		this.teacherArea3 = teacherArea3;
		this.teacherArea4 = teacherArea4;
		this.teacherName = teacherName;
		this.teacherSchool = teacherSchool;
		this.teacherHomePhone = teacherHomePhone;
		this.teacherWorkPhone = teacherWorkPhone;
		this.teacherSignature = teacherSignature;
		this.teacherSignDate = teacherSignDate;
		this.principalSignature = principalSignature;
		this.principalSignDate = principalSignDate;
		this.loggedInUserId = loggedInUserId;
		this.loggedInUserPersonType = loggedInUserPersonType;
	}

