	@Test
	void testUnzip_ZipSlipBackslashPath() throws Exception {

		File maliciousZip = new File(tempDir.toFile(), "backslash-malicious.zip");

		try (java.util.zip.ZipOutputStream zos = new java.util.zip.ZipOutputStream(
				Files.newOutputStream(maliciousZip.toPath()))) {

			ZipEntry entry = new ZipEntry("folder/../../evil.txt");

			zos.putNextEntry(entry);
			zos.write("malicious".getBytes(StandardCharsets.UTF_8));
			zos.closeEntry();
		}

		File output = new File(tempDir.toFile(), "safe-backslash-output");

		assertThrows(Exception.class, () -> utility.unzip(maliciousZip.getAbsolutePath(), output.getAbsolutePath()));
	}

